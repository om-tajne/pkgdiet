{
  "name": "@pkgdiet/core",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./alternatives": {
      "import": "./dist/alternatives.js"
    },
    "./data/alternatives.json": "./data/alternatives.json",
    "./dist/*.js": "./dist/*.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@babel/parser": "^7.27.0",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  },
  "description": "A local-first dependency gate and MCP server for checking npm package health and alternatives.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model context protocol",
    "dependencies",
    "security",
    "npm",
    "health"
  ],
  "homepage": "https://github.com/om-tajne/pkgdiet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/om-tajne/pkgdiet.git"
  },
  "bugs": {
    "url": "https://github.com/om-tajne/pkgdiet/issues"
  }
}
