{
  "name": "pkgdiet-vscode",
  "displayName": "PkgDiet",
  "description": "Dependency health, policy, and alternatives for package.json.",
  "version": "2.0.0",
  "private": true,
  "publisher": "om-tajne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/om-tajne/pkgdiet.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other",
    "Extension Packs"
  ],
  "keywords": [
    "npm",
    "dependencies",
    "security",
    "mcp",
    "ai",
    "package.json",
    "supply chain"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:json",
    "onCommand:pkgdiet.checkDependency",
    "workspaceContains:package.json"
  ],
  "contributes": {
    "commands": [
      {
        "title": "PkgDiet: Check Dependency",
        "category": "PkgDiet",
        "command": "pkgdiet.checkDependency"
      },
      {
        "title": "PkgDiet: Audit Project",
        "category": "PkgDiet",
        "command": "pkgdiet.auditProject"
      },
      {
        "title": "PkgDiet: Open Policy File",
        "category": "PkgDiet",
        "command": "pkgdiet.openPolicy"
      }
    ],
    "configuration": {
      "properties": {
        "pkgdiet.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check modified dependencies after saving package.json."
        },
        "pkgdiet.environment": {
          "type": "string",
          "default": "dev",
          "enum": [
            "ci",
            "dev",
            "prod",
            "staging"
          ],
          "description": "Policy environment to apply for dependency checks."
        },
        "pkgdiet.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Show detailed diagnostic information in the Output panel."
        },
        "pkgdiet.networkChecks": {
          "type": "boolean",
          "default": true,
          "description": "Allow PkgDiet to query npm registry metadata for health scores and size estimates."
        },
        "pkgdiet.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable PkgDiet dependency diagnostics in package.json."
        }
      },
      "title": "PkgDiet"
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "build": "npm run compile"
  },
  "dependencies": {
    "@pkgdiet/core": "^2.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  }
}
