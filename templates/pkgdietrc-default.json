{
  "policyVersion": 1,
  "telemetry": false,
  "minHealthScore": 60,
  "warnHealthScore": 75,
  "maxPackageSizeBytes": 10485760,
  "failOn": "BLOCK",
  "securityMode": "fail-open",
  "blockDeprecated": true,
  "blockInstallScripts": true,
  "blockKnownVulnerabilities": true,
  "blockTyposquats": true,
  "blockOnLowHealth": false,
  "blockedPackages": [
    "left-pad",
    "i-can-haz-express"
  ],
  "allowedPackages": [],
  "internalNamePrefixes": [
    "corp-",
    "internal-",
    "infra-",
    "private-"
  ],
  "ignoreRules": [],
  "environments": {
    "ci": {
      "minHealthScore": 70,
      "warnHealthScore": 80,
      "failOn": "BLOCK",
      "securityMode": "fail-closed",
      "blockOnLowHealth": true
    },
    "dev": {
      "minHealthScore": 60,
      "warnHealthScore": 75,
      "failOn": "BLOCK",
      "securityMode": "fail-open"
    }
  }
}
