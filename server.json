{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.om-tajne/pkgdiet",
  "version": "2.0.1",
  "description": "Dependency policy and MCP server to stop AI coding agents from installing risky npm packages.",
  "repository": {
    "source": "github",
    "url": "https://github.com/om-tajne/pkgdiet"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "pkgdiet",
      "version": "2.0.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
