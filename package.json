{
  "name": "pkgdiet-monorepo",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "A local-first dependency gate and MCP server for checking npm package health and alternatives.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model context protocol",
    "dependencies",
    "security",
    "npm",
    "health"
  ],
  "homepage": "https://github.com/om-tajne/pkgdiet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/om-tajne/pkgdiet.git"
  },
  "bugs": {
    "url": "https://github.com/om-tajne/pkgdiet/issues"
  }
}
